<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <!-- Favicon 설정 (브라우저 캐시 방지 적용) -->
    <link rel="shortcut icon" href="/favicon.ico?v=2" type="image/x-icon">
    <link rel="icon" href="/favicon.webp?v=2" type="image/png">

    <!-- 검색엔진 소유권 인증 태그 -->
    <meta name="naver-site-verification" content="022f7c4c02012d90450260ae8572d94cd628e415" />
    <meta name="google-site-verification" content="455YHK66VecF8j-Xs5JbBjKP-KRKIqW3hpkDJVOkJMs" />

    <!-- 기본 SEO 메타 태그 -->
    <meta name="description"
        content="<%= locals.metaDescription || '20여 년 노하우의 프리미엄 숙성회 전문 프랜차이즈 물고기자리. 최상급 활선어 무한리필과 성공적인 소자본 횟집 창업 솔루션을 제공합니다.' %>">
    <meta name="keywords" content="<%= locals.metaKeywords || '물고기자리, 숙성회, 무한리필, 활어회, 프랜차이즈, 창업, 맛집, 횟집' %>">
    <meta name="author" content="물고기자리">
    <meta name="robots" content="index, follow">

    <!-- Open Graph (카카오톡, 네이버 블로그 등 SNS 공유용) -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description"
        content="<%= locals.metaDescription || '20여 년 노하우의 프리미엄 숙성회 전문 프랜차이즈 물고기자리. 최상급 활선어 무한리필과 성공적인 소자본 횟집 창업 솔루션을 제공합니다.' %>">
    <meta property="og:image" content="<%= baseUrl %>/images/logo/meta-logo.webp">
    <meta property="og:url" content="<%= baseUrl %>">
    <meta property="og:site_name" content="물고기자리">

    <!-- Twitter Card (X/트위터 공유용) -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title %>">
    <meta name="twitter:description"
        content="<%= locals.metaDescription || '20여 년 노하우의 프리미엄 숙성회 전문 프랜차이즈 물고기자리. 최상급 활선어 무한리필과 성공적인 소자본 횟집 창업 솔루션을 제공합니다.' %>">
    <meta name="twitter:image" content="<%= baseUrl %>/images/logo/meta-logo.webp">

    <!-- 네이버 / 구글 검색엔진 수집 최적화 (JSON-LD 구조화 데이터) -->
    <!-- 1. 기업/법인 및 브랜드 지식 그래프 (Organization & Brand) -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": "https://piscesfc.com/#organization",
        "name": "주식회사 물고기파트너스",
        "legalName": "주식회사 물고기파트너스",
        "alternateName": "Fish Partners",
        "url": "https://piscesfc.com/",
        "description": "주식회사 물고기파트너스는 프리미엄 숙성회 전문 브랜드 물고기자리를 운영하는 외식 프랜차이즈 기업입니다. 자체 가공센터의 손질 완료 필렛 공급, 저온 숙성, 콜드체인 배송 및 가맹점 운영 지원 시스템을 제공합니다.",
        "brand": {
            "@type": "Brand",
            "@id": "https://piscesfc.com/#brand",
            "name": "물고기자리",
            "alternateName": "PISCES PREMIUM",
            "url": "https://piscesfc.com/",
            "description": "2002년부터 운영 경험을 쌓아온 프리미엄 숙성회 전문 외식 브랜드"
        },
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "죽전로 17, 703호 (보정동, 풍산프라자)",
            "addressLocality": "용인시 기흥구",
            "addressRegion": "경기도",
            "addressCountry": "KR"
        },
        "telephone": "+82-1566-6851",
        "email": "fishpartners@naver.com",
        "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+82-1566-6851",
            "contactType": "franchise inquiries",
            "availableLanguage": "Korean"
        }
    }
    </script>

    <!-- 2. 프랜차이즈 레스토랑 정보 (Restaurant) -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Restaurant",
        "@id": "https://piscesfc.com/#restaurant",
        "name": "물고기자리",
        "alternateName": "물고기자리 프리미엄 숙성회",
        "image": "<%= baseUrl %>/images/logo/meta-logo.webp",
        "url": "<%= baseUrl %>",
        "description": "<%= (locals.metaDescription || '20여 년 노하우의 프리미엄 숙성회 전문 프랜차이즈 물고기자리. 최상급 활선어 무한리필과 성공적인 소자본 횟집 창업 솔루션을 제공합니다.').replace(/\"/g, '\\\"') %>",
        "servesCuisine": "Japanese, Sashimi",
        "priceRange": "₩₩₩",
        "brand": {
            "@id": "https://piscesfc.com/#brand"
        },
        "parentOrganization": {
            "@id": "https://piscesfc.com/#organization"
        }
    }
    </script>

    <!-- 3. 공식 웹사이트 및 검색 스키마 (WebSite) -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://piscesfc.com/#website",
        "name": "물고기자리",
        "alternateName": "PISCES PREMIUM",
        "url": "https://piscesfc.com/",
        "inLanguage": "ko-KR",
        "description": "물고기자리 공식 홈페이지. 프리미엄 숙성회, 숙성회 전문점 창업, 횟집 프랜차이즈, 필렛 공급 시스템, 가맹 창업비용, 메뉴 및 전국 매장 정보를 안내합니다.",
        "publisher": {
            "@id": "https://piscesfc.com/#organization"
        },
        "about": {
            "@id": "https://piscesfc.com/#brand"
        },
        "potentialAction": {
            "@type": "SearchAction",
            "target": "<%= baseUrl %>/stores?search={search_term_string}",
            "query-input": "required name=search_term_string"
        }
    }
    </script>

    <!-- 외부 도메인 DNS/TLS 프리커넥트 (네트워크 핸드셰이크 지연 0ms화) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">

    <!-- 히어로 포스터 이미지 사전 로딩 (0.01초 최우선 visual 렌더링) -->
    <link rel="preload" as="image" href="/images/main_dish.webp" type="image/webp">

    <!-- Web Fonts 병렬 직접 로딩 (CSS @import 워터폴 병목 제거) -->
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Anton&family=Noto+Sans+KR:wght@300;400;500;700;900&family=Outfit:wght@300;400;600;800&display=swap">
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css">

    <link rel="stylesheet" href="/css/style.css?v=14.7">
    <link rel="stylesheet" href="/css/shorts.css?v=1.1">

    <!-- Non-blocking 외부 라이브러리 스크립트 (defer 로딩으로 HTML 렌더링 블로킹 100% 해제) -->
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script defer src="https://unpkg.com/@studio-freight/lenis@1.0.33/dist/lenis.min.js"></script>
</head>

<body>
    <%- include('header') %>

        <main>