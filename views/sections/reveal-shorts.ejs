<!-- 서클 마스크 리빌 섹션 (장인의 손길 & 유튜브 쇼츠 컴포넌트) -->
<section class="reveal-section">
    <div class="reveal-inner">
        <!-- 배경으로 깔리는 숏츠 영역 -->
        <div class="shorts-container">
            <div class="shorts-grid-area">
                <div class="shorts-carousel-container">
                    <button type="button" class="shorts-nav-btn shorts-nav-prev" id="shortsPrevBtn" aria-label="이전 영상">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>
                    <div class="shorts-grid" id="shortsSliderTrack">
                        <div class="shorts-card active" data-index="0" data-video-id="m9pZFFKTZNM">
                            <iframe id="shortsIframe0" src="https://www.youtube.com/embed/m9pZFFKTZNM?enablejsapi=1&autoplay=1&mute=1&controls=0&playsinline=1&rel=0&modestbranding=1&iv_load_policy=3&disablekb=1&fs=0" title="물고기자리 쇼츠 1"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                            <div class="shorts-screen-overlay" aria-label="쇼츠 재생 제어"></div>
                        </div>
                        <div class="shorts-card" data-index="1" data-video-id="C_lTrWN_eYw">
                            <iframe id="shortsIframe1" src="https://www.youtube.com/embed/C_lTrWN_eYw?enablejsapi=1&autoplay=0&mute=1&controls=0&playsinline=1&rel=0&modestbranding=1&iv_load_policy=3&disablekb=1&fs=0" title="물고기자리 쇼츠 2"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                            <div class="shorts-screen-overlay" aria-label="쇼츠 재생 제어"></div>
                        </div>
                        <div class="shorts-card" data-index="2" data-video-id="vNrSLSDOTls">
                            <iframe id="shortsIframe2" src="https://www.youtube.com/embed/vNrSLSDOTls?enablejsapi=1&autoplay=0&mute=1&controls=0&playsinline=1&rel=0&modestbranding=1&iv_load_policy=3&disablekb=1&fs=0" title="물고기자리 쇼츠 3"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                            <div class="shorts-screen-overlay" aria-label="쇼츠 재생 제어"></div>
                        </div>
                    </div>
                    <button type="button" class="shorts-nav-btn shorts-nav-next" id="shortsNextBtn" aria-label="다음 영상">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                </div>
                <div class="shorts-dots" id="shortsDots">
                    <button type="button" class="shorts-dot active" data-dot="0" aria-label="1번 영상"></button>
                    <button type="button" class="shorts-dot" data-dot="1" aria-label="2번 영상"></button>
                    <button type="button" class="shorts-dot" data-dot="2" aria-label="3번 영상"></button>
                </div>
            </div>

            <div class="shorts-text-area">
                <h3 class="shorts-title">홍보하지 않아도 잘되는 곳은<br>이유가 있습니다.</h3>
                <div class="shorts-metrics">
                    <div class="shorts-desc-group">
                        <p class="shorts-desc-item highlight-desc">
                            개별적 영상광고 하실 필요 없는<br>
                            브랜드 알고리즘 이미 형성되어 있는 숙성회 브랜드
                        </p>
                        <p class="shorts-desc-item">
                            소비자는 이미 내 지역에도 물고기자리가<br>
                            오픈하기만을 기다리고 있습니다.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 스크롤 시 확장될 마스킹 레이어 (장인의 손길 이미지) -->
        <div class="reveal-overlay">
            <div class="reveal-image-container">
                <img src="/images/artisan_hands.webp" alt="장인의 손길" loading="lazy" decoding="async">
            </div>
        </div>
    </div>
</section>
