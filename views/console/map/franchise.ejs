<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | 물고기자리 관리자</title>
    <link rel="icon" type="image/png" href="/images/logo.webp">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Admin Dashboard CSS -->
    <link rel="stylesheet" href="/css/admin-dashboard.css">

    <style>
        * { box-sizing: border-box; }
        body { margin: 0; padding: 0; font-family: 'Noto Sans KR', sans-serif; background-color: #f8fafc; color: #0f172a; }
        .dashboard-layout { display: flex; min-height: 100vh; }
        .console-sidebar { width: 260px; background: #0f172a; color: #ffffff; padding: 30px 20px; flex-shrink: 0; display: flex; flex-direction: column; transition: all 0.3s ease; position: fixed; top: 0; bottom: 0; left: 0; z-index: 99; }
        .sidebar-logo { display: flex; align-items: center; gap: 10px; padding-bottom: 30px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); margin-bottom: 30px; }
        .sidebar-logo img { height: 32px; width: auto; }
        .sidebar-logo span { font-family: 'Outfit', sans-serif; font-size: 14px; font-weight: 700; color: #0284c7; letter-spacing: 1px; text-transform: uppercase; border: 1px solid rgba(2, 132, 199, 0.4); padding: 2px 6px; border-radius: 4px; background: rgba(2, 132, 199, 0.1); }
        .sidebar-menu { display: flex; flex-direction: column; gap: 6px; }
        .menu-item { display: flex; align-items: center; gap: 12px; padding: 12px 16px; color: #94a3b8; text-decoration: none; font-size: 14px; font-weight: 500; border-radius: 10px; transition: all 0.2s ease; }
        .menu-item svg { width: 18px; height: 18px; flex-shrink: 0; }
        .menu-item:hover { color: #ffffff; background: rgba(255, 255, 255, 0.05); }
        .menu-item.active { color: #ffffff; background: #0284c7; font-weight: 700; box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3); }
        .menu-item.sub-item { padding-left: 24px; font-size: 13px; }
        .console-main { flex: 1; margin-left: 260px; padding: 40px; background-color: #f8fafc; }
        .main-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; border-bottom: 1px solid #e2e8f0; padding-bottom: 20px; }
        .main-header-title h2 { font-size: 26px; font-weight: 800; margin: 0; color: #0f172a; letter-spacing: -0.5px; }
        .main-header-title p { font-size: 13px; color: #64748b; margin: 6px 0 0 0; }
        .header-profile-wrap { display: flex; align-items: center; gap: 15px; background: #ffffff; border: 1px solid #e2e8f0; padding: 8px 16px; border-radius: 12px; }
        .header-profile-wrap .user-name { font-size: 13px; font-weight: 800; color: #0f172a; }
        .header-profile-wrap .user-role { font-size: 10px; color: #64748b; }
        .btn-logout { display: flex; align-items: center; gap: 6px; padding: 6px 12px; background: rgba(239, 68, 68, 0.06); border: 1px solid rgba(239, 68, 68, 0.15); color: #ef4444; font-size: 12px; font-weight: 700; border-radius: 8px; text-decoration: none; }
        .btn-logout:hover { background: #ef4444; color: #ffffff; }

        /* 테이블 및 카드 스타일 */
        .board-container { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 28px; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.015); }
        .board-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
        .board-info h2 { font-size: 20px; font-weight: 800; margin: 0; color: #0f172a; }
        .board-count { font-size: 13px; color: #64748b; margin: 4px 0 0 0; }
        .btn-primary-add { display: inline-flex; align-items: center; gap: 8px; background: #0284c7; color: #ffffff; font-size: 14px; font-weight: 700; padding: 10px 20px; border-radius: 10px; text-decoration: none; transition: all 0.2s ease; box-shadow: 0 4px 12px rgba(2, 132, 199, 0.2); }
        .btn-primary-add:hover { background: #0369a1; transform: translateY(-1px); }
        .board-table { width: 100%; border-collapse: collapse; font-size: 14px; }
        .board-table th { padding: 14px 16px; color: #64748b; font-weight: 700; border-bottom: 1.5px solid #e2e8f0; font-size: 12px; text-align: left; background-color: #f8fafc; }
        .board-table td { padding: 16px; border-bottom: 1px solid #f1f5f9; color: #334155; vertical-align: middle; }
        .status-badge { display: inline-block; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 700; }
        .status-badge.completed { background: rgba(22, 163, 74, 0.1); color: #16a34a; }
        .status-badge.pending { background: rgba(239, 68, 68, 0.1); color: #ef4444; }
        .view-btn { padding: 6px 14px; background: #f1f5f9; color: #0f172a; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 700; transition: all 0.2s ease; }
        .view-btn:hover { background: #0284c7; color: #ffffff; }
        .delete-btn-table { padding: 6px 14px; background: rgba(239, 68, 68, 0.08); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 6px; font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.2s ease; }
        .delete-btn-table:hover { background: #ef4444; color: #ffffff; }

        .mobile-header { display: none; padding: 15px 20px; background: #ffffff; border-bottom: 1px solid #e2e8f0; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 100; }
        .mobile-menu-btn { background: none; border: none; color: #0f172a; cursor: pointer; padding: 5px; }
        .sidebar-backdrop { display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.4); z-index: 98; }

        @media (max-width: 992px) {
            .console-sidebar { transform: translateX(-100%); }
            .console-sidebar.open { transform: translateX(0); box-shadow: 10px 0 35px rgba(15, 23, 42, 0.1); }
            .console-main { margin-left: 0; padding: 30px 20px; }
            .mobile-header { display: flex; }
            .main-header { display: none; }
            .sidebar-backdrop.open { display: block; }
            .desktop-only { display: none !important; }
            .mobile-only { display: block !important; }
        }
        @media (min-width: 993px) {
            .mobile-only { display: none !important; }
        }
        
        .mobile-card-list { display: flex; flex-direction: column; gap: 16px; }
        .inquiry-card { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; }
        .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
        .card-name { font-size: 16px; font-weight: 800; color: #0f172a; margin-bottom: 8px; }
        .card-info-row { font-size: 13px; color: #64748b; margin-bottom: 16px; }
        .view-btn-full { display: block; width: 100%; text-align: center; padding: 10px; background: #f1f5f9; color: #0f172a; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 13px; }
    </style>
</head>

<body>
    <!-- 모바일 전용 헤더 -->
    <div class="mobile-header">
        <div style="display: flex; align-items: center; gap: 10px;">
            <button class="mobile-menu-btn" id="btnToggleMenu" aria-label="메뉴 열기">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
            <img src="/images/logo.webp" alt="물고기자리" style="height: 28px; width: auto;">
        </div>
        <span style="color: #0284c7; font-size: 11px; font-weight: bold; border: 1px solid rgba(2,132,199,0.3); padding: 1px 4px; border-radius: 4px; background: rgba(2,132,199,0.05);">console</span>
    </div>

    <!-- 모바일 사이드바 백드롭 -->
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <div class="dashboard-layout">
        <!-- 좌측 고정 사이드바 -->
        <div class="console-sidebar" id="consoleSidebar">
            <div class="sidebar-logo">
                <img src="/images/logo.webp" alt="물고기자리 로고">
                <span>console</span>
            </div>
            
            <div class="sidebar-menu">
                <!-- 1. 대쉬보드 -->
                <a href="/console/dashboard" class="menu-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="9"></rect>
                        <rect x="14" y="3" width="7" height="5"></rect>
                        <rect x="14" y="12" width="7" height="9"></rect>
                        <rect x="3" y="16" width="7" height="5"></rect>
                    </svg>
                    <span>대쉬보드</span>
                </a>

                <!-- 2. 게시판 관리 -->
                <div class="menu-group" style="display: flex; flex-direction: column; gap: 4px; margin-top: 10px;">
                    <div class="menu-group-title" style="padding: 5px 20px; font-size: 11px; font-weight: bold; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px;">게시판 관리</div>
                    <a href="/console/board/notice" class="menu-item sub-item">
                        <span>- 공지사항 관리</span>
                    </a>
                    <a href="/console/board/faq" class="menu-item sub-item">
                        <span>- FAQ 관리</span>
                    </a>
                    <a href="/console/board/voice" class="menu-item sub-item">
                        <span>- 고객의 소리 관리</span>
                    </a>
                    <a href="/console/board/inquiry" class="menu-item sub-item">
                        <span>- 문의게시판 관리</span>
                    </a>
                </div>

                <!-- 3. 메뉴(음식) 관리 -->
                <a href="/console/menu" class="menu-item" style="margin-top: 10px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        <path d="M2 12h20"></path>
                    </svg>
                    <span>메뉴(음식) 관리</span>
                </a>

                <!-- 4. 팝업관리 -->
                <a href="/console/popup" class="menu-item" style="margin-top: 10px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="9" y1="3" x2="9" y2="21"></line>
                        <line x1="17" y1="9" x2="21" y2="9"></line>
                        <line x1="17" y1="15" x2="21" y2="15"></line>
                    </svg>
                    <span>팝업관리</span>
                </a>

                <!-- 5. 가맹점 관리 (활성화) -->
                <a href="/console/franchise" class="menu-item active" style="margin-top: 10px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>가맹점 관리</span>
                </a>
            </div>
        </div>

        <!-- 우측 메인 콘텐츠 영역 -->
        <div class="console-main">
            <!-- 메인 헤더 -->
            <div class="main-header">
                <div class="main-header-title">
                    <h2>가맹점(매장) 관리</h2>
                    <p>전국의 물고기자리 가맹 매장 목록을 조회, 등록, 수정 및 삭제 관리합니다.</p>
                </div>
                
                <% const userInfo = (typeof user !== 'undefined' && user) ? user : ((typeof adminUser !== 'undefined' && adminUser) ? adminUser : {}); %>
                <div class="header-profile-wrap">
                    <div style="display: flex; flex-direction: column; gap: 2px;">
                        <span class="user-name"><%= userInfo.name || '관리자' %> 님</span>
                        <span class="user-role"><%= userInfo.role === 'super_admin' ? '최고관리자' : '관리자' %></span>
                    </div>
                    <a href="/console/logout" class="btn-logout">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>로그아웃</span>
                    </a>
                </div>
            </div>

            <!-- 페이지 콘텐츠 -->
            <div class="board-container">
                <div class="board-header">
                    <div class="board-info">
                        <h2>가맹점 목록</h2>
                        <p class="board-count">전체 <strong><%= stores ? stores.length : 0 %></strong>개 매장 등록됨</p>
                    </div>
                    <a href="/console/franchise/add" class="btn-primary-add">
                        <i class="fas fa-plus"></i>
                        신규 가맹점 추가
                    </a>
                </div>

                <div class="board-content">
                    <% if (stores && stores.length > 0) { %>
                        <!-- 데스크톱 전용 테이블 -->
                        <div class="desktop-only">
                            <table class="board-table">
                                <thead>
                                    <tr>
                                        <th>매장명</th>
                                        <th>연락처</th>
                                        <th>주소</th>
                                        <th>위도 / 경도</th>
                                        <th>상태</th>
                                        <th style="width: 140px; text-align: center;">관리</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% stores.forEach(store => { %>
                                        <tr>
                                            <td style="font-weight: 800; color: #0f172a;"><%= store.name %></td>
                                            <td style="color: #0284c7; font-weight: 600;"><%= store.phone || '-' %></td>
                                            <td><%= store.address %></td>
                                            <td style="font-size: 12px; color: #64748b; font-family: monospace;">
                                                <%= store.lat %>, <%= store.lng %>
                                            </td>
                                            <td>
                                                <span class="status-badge <%= store.use_yn === 'Y' ? 'completed' : 'pending' %>">
                                                    <%= store.use_yn === 'Y' ? '노출중' : '숨김' %>
                                                </span>
                                            </td>
                                            <td>
                                                <div style="display: flex; gap: 6px; justify-content: center;">
                                                    <a href="/console/franchise/edit/<%= store.id %>" class="view-btn">수정</a>
                                                    <button onclick="deleteStore(<%= store.id %>, '<%= store.name %>')" class="delete-btn-table">삭제</button>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>

                        <!-- 모바일 전용 카드 리스트 -->
                        <div class="mobile-card-list mobile-only">
                            <% stores.forEach(store => { %>
                                <div class="inquiry-card">
                                    <div class="card-header">
                                        <span class="status-badge <%= store.use_yn === 'Y' ? 'completed' : 'pending' %>">
                                            <%= store.use_yn === 'Y' ? '노출중' : '숨김' %>
                                        </span>
                                        <span style="font-size: 13px; color: #0284c7; font-weight: bold;">
                                            <%= store.phone || '연락처 없음' %>
                                        </span>
                                    </div>
                                    <div class="card-body">
                                        <div class="card-name"><%= store.name %></div>
                                        <div class="card-info-row">
                                            <i class="fas fa-map-marker-alt" style="color: #0284c7; margin-right: 4px;"></i>
                                            <%= store.address %>
                                        </div>
                                    </div>
                                    <div style="display: flex; gap: 10px; margin-top: 12px;">
                                        <a href="/console/franchise/edit/<%= store.id %>" class="view-btn-full" style="flex: 1;">수정</a>
                                        <button onclick="deleteStore(<%= store.id %>, '<%= store.name %>')" class="delete-btn-table" style="flex: 1;">삭제</button>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div style="text-align: center; padding: 60px 20px; color: #64748b;">
                            <i class="fas fa-store" style="font-size: 48px; color: #cbd5e1; margin-bottom: 16px; display: block;"></i>
                            <p style="font-size: 15px; margin: 0;">등록된 가맹점이 없습니다.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script>
        const btnToggleMenu = document.getElementById('btnToggleMenu');
        const consoleSidebar = document.getElementById('consoleSidebar');
        const sidebarBackdrop = document.getElementById('sidebarBackdrop');

        if (btnToggleMenu && consoleSidebar && sidebarBackdrop) {
            const toggleSidebar = () => {
                consoleSidebar.classList.toggle('open');
                sidebarBackdrop.classList.toggle('open');
            };
            btnToggleMenu.addEventListener('click', toggleSidebar);
            sidebarBackdrop.addEventListener('click', toggleSidebar);
        }

        function deleteStore(id, name) {
            if (confirm(`'${name}' 매장을 정말 삭제하시겠습니까?`)) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/console/franchise/delete/${id}`;
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
</body>

</html>